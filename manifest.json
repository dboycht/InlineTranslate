{
  "manifest_version": 3,
  "name": "行内翻译 Inline Translate",
  "version": "1.00.3",
  "description": "在网页每段文字下方显示译文（不覆盖原文），支持 Google / DeepL / 百度 / 有道等翻译 API，以及 OpenAI / DeepSeek / Claude 等 AI 大模型。",
  "author": "VibeCoding",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "行内翻译",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["providers.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "翻译当前页面（在每段文字下方显示译文）"
    }
  }
}
